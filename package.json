{
  "name": "rx-twitter",
  "version": "3.1.2",
  "description": "Twitter/Xの投稿URLをDiscord上で見やすいEmbedに展開するBot",
  "type": "module",
  "imports": {
    "#/*": "./dist/*"
  },
  "main": "index.js",
  "private": true,
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "twitter",
    "x-twitter",
    "fxtwitter",
    "vxtwitter",
    "redis",
    "typescript"
  ],
  "homepage": "https://github.com/rx-twitter/rx-twitter#readme",
  "bugs": {
    "url": "https://github.com/rx-twitter/rx-twitter/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "t1nyb0x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rx-twitter/rx-twitter.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "start:docker": "node ./dist/index.js",
    "debug": "tsc --noEmit && tsx watch --env-file=.env src/index.ts",
    "clean": "rm -rf dist",
    "compile": "npm run clean && tsc -p .",
    "compile:test": "tsc -p . --noEmit",
    "compile:tests": "tsc -p tsconfig.test.json --noEmit",
    "build": "npm run build:shared && npm run compile",
    "verify:dist": "node scripts/check-dist-resolution.mjs",
    "build:shared": "npm run build --workspace=@rx-twitter/shared",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/ tests/",
    "format": "oxfmt src/",
    "gen:api": "orval --config ./orval.config.ts && node scripts/fix-generated-imports.mjs"
  },
  "dependencies": {
    "@discordjs/builders": "^1.9.0",
    "@hono/node-server": "^2.1.3",
    "@rx-twitter/shared": "*",
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13",
    "js-yaml": "^5.2.3",
    "redis": "^6.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "orval": "8.46.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
